{
  "name": "@rocketsarenostalgic/quality-config",
  "version": "0.1.0",
  "description": "Shared ESLint, Prettier and Stylelint configuration for Rockets Are Nostalgic projects.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/RocketsAreNostalgic/ran-quality-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/RocketsAreNostalgic/ran-quality-config.git"
  },
  "files": [
    "eslint/",
    "prettier/",
    "stylelint/",
    "README.md"
  ],
  "exports": {
    "./eslint/wordpress": "./eslint/wordpress.js",
    "./prettier": "./prettier/index.cjs",
    "./stylelint/wordpress": "./stylelint/wordpress.cjs",
    "./stylelint/wordpress-scss": "./stylelint/wordpress-scss.cjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "pnpm test"
  },
  "dependencies": {
    "@wordpress/eslint-plugin": "25.7.0",
    "@wordpress/prettier-config": "4.51.0",
    "@wordpress/stylelint-config": "24.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "stylelint": "^16.26.1",
    "stylelint-scss": "^6.14.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylelint": "16.26.1",
    "stylelint-scss": "6.14.0"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.13.1",
  "publishConfig": {
    "access": "public"
  }
}
